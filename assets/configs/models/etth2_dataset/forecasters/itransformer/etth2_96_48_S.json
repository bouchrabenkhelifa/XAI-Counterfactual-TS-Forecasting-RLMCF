{
  "model_name": "iTransformer",
  "dataset_name": "ETTh2",

  "root_path": "assets/datasets",
  "data_path": "ETTh2.csv",

  "features": "S",
  "target": "OT",
  "freq": "h",

  "seq_len": 96,
  "label_len": 48,
  "pred_len": 48,

  "enc_in": 1,
  "dec_in": 1,
  "c_out": 1,

  "d_model": 256,
  "n_heads": 8,
  "e_layers": 2,
  "d_layers": 1,
  "d_ff": 256,
  "factor": 1,
  "dropout": 0.2,
  "embed": "timeF",
  "activation": "gelu",
  "output_attention": false,

  "moving_avg": 25,
  "distil": true,
  "class_strategy": "projection",

  "batch_size": 16,
  "num_workers": 0,
  "train_epochs": 50,
  "patience": 10,
  "learning_rate": 0.00005,
  "loss": "MSE",
  "lradj": "type1",
  "use_amp": false,

  "use_gpu": true,
  "gpu": 0,
  "use_norm": true,
  "inverse": false,
  "channel_independence": false,

  "checkpoint_dir": "assets/checkpoints/etth2_chpts/forecaster",
  "checkpoint_name": "chpt_etth2_96_48_S.pth",
  "history_name": "history_etth2_96_48_S.json",
  "results_dir": "assets/results/etth2/forecaster",
  "figures_dir": "assets/figures/etth2/forecaster/itransformer",

  "plot_training_curves": true,
  "plot_forecast_examples": true,
  "plot_error_distribution": true
}
