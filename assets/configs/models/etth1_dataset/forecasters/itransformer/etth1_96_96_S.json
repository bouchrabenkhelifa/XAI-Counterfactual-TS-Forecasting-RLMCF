{
  "model_name": "iTransformer",
  "dataset_name": "ETTh1",

  "root_path": "assets/datasets",
  "data_path": "ETTh1.csv",

  "features": "S",
  "target": "OT",
  "freq": "h",

  "seq_len": 96,
  "label_len": 48,
  "pred_len": 96,

  "enc_in": 1,
  "dec_in": 1,
  "c_out": 1,

  "d_model": 512,
  "n_heads": 8,
  "e_layers": 3,
  "d_layers": 1,
  "d_ff": 512,
  "factor": 1,
  "dropout": 0.1,
  "embed": "timeF",
  "activation": "gelu",
  "output_attention": false,

  "moving_avg": 25,
  "distil": true,
  "class_strategy": "projection",

  "batch_size": 32,
  "num_workers": 0,
  "train_epochs": 50,
  "patience": 10,
  "learning_rate": 0.0001,
  "loss": "MSE",
  "lradj": "type1",
  "use_amp": false,

  "use_gpu": true,
  "gpu": 0,
  "use_norm": true,
  "inverse": false,
  "channel_independence": false,

  "checkpoint_dir": "assets/checkpoints/etth1_chpts/forecaster",
  "checkpoint_name": "chpt_etth1_96_96_S.pth",
  "history_name": "history_etth1_96_96_S.json",
  "results_dir": "assets/results/forecaster",
  "figures_dir": "assets/figures/forecaster"
}