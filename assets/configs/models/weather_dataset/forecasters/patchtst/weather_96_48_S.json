{
  "model_type": "PatchTST",
  "dataset_name": "custom",

  "root_path": "assets/datasets",
  "data_path": "weather.csv",

  "features": "S",
  "target": "T (degC)",
  "freq": "t",

  "seq_len": 96,
  "label_len": 48,
  "pred_len": 48,

  "enc_in": 1,
  "dec_in": 1,
  "c_out": 1,

  "d_model": 128,
  "n_heads": 8,
  "e_layers": 3,
  "d_ff": 256,
  "factor": 1,
  "dropout": 0.1,
  "activation": "gelu",
  "embed": "timeF",

  "patch_len": 16,
  "stride": 8,

  "batch_size": 32,
  "num_workers": 0,
  "train_epochs": 50,
  "patience": 10,
  "learning_rate": 0.0001,
  "loss": "MSE",
  "lradj": "type2",
  "use_amp": false,

  "use_gpu": true,
  "gpu": 0,
  "inverse": false,

  "checkpoint_dir": "assets/checkpoints/weather_chpts/forecaster",
  "checkpoint_name": "chpt_weather_96_48_patchtst_S.pth",
  "history_name": "history_weather_96_48_patchtst_S.json",
  "results_dir": "assets/results/weather/forecaster",
  "figures_dir": "assets/figures/weather/forecaster"
}
