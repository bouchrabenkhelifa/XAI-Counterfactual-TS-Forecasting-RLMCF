{
  "model_type": "iTransformer",
  "dataset_name": "Weather",
  "root_path": "assets/datasets",
  "data_path": "weather.csv",
  "features": "S",
  "target": "T (degC)",
  "freq": "t",
  "seq_len": 96,
  "label_len": 48,
  "pred_len": 96,
  "enc_in": 1,
  "dec_in": 1,
  "c_out": 1,
  "d_model": 512,
  "n_heads": 8,
  "e_layers": 3,
  "d_layers": 1,
