  "num_workers": 0,
  "train_epochs": 50,
  "patience": 10,
  "learning_rate": 0.0001,
  "loss": "MSE",
  "lradj": "type1",
  "use_amp": false,
  "use_gpu": true,
  "gpu": 0,
  "use_norm": true,
  "inverse": false,
  "channel_independence": false,
  "checkpoint_dir": "assets/checkpoints/weather_chpts/forecaster",
  "checkpoint_name": "chpt_weather_96_96_itransformer_S.pth",
  "history_name": "history_weather_96_96_itransformer_S.json",
  "results_dir": "assets/results/weather/forecaster",
  "figures_dir": "assets/figures/weather/forecaster/itransformer"
}
