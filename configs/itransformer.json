{
  "data_path": "assets/datasets/ETTh1.csv",
  "target_col": "OT",
  "date_col": "date",

  "train_ratio": 0.7,
  "val_ratio": 0.1,

  "seq_len": 48,
  "label_len": 24,
  "pred_len": 256,
  "freq": "h",

  "batch_size": 32,
  "epochs": 20,
  "learning_rate": 0.001,
  "weight_decay": 0.0,

  "output_attention": false,
  "use_norm": true,
  "class_strategy": "none",
  "d_model": 8,
  "n_heads": 2,
  "e_layers": 3,
  "d_ff": 256,
  "factor": 5,
  "dropout": 0.2,
  "activation": "gelu",
  "embed": "timeF",

  "checkpoint_dir": "assets/checkpoints/forecaster",
  "checkpoint_name": "itransformer_etth1_best.pth",
  "device": "cuda"
}